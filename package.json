{
  "name": "@nbardy/agent-cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Shared CLI agent invocation tool — single source of truth for invoking Claude, Codex, OpenCode, Gemini CLIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/write-dist-package.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/../test/*.test.ts",
    "test:live:gemini": "node scripts/run-live-gemini-test.mjs",
    "test:live:subagents": "node scripts/run-live-subagent-probe.mjs",
    "test:live:time-effort": "node scripts/run-time-effort-test.mjs",
    "manual:capture": "node manual_tests/capture-live-run.mjs",
    "manual:subagents:codex:raw": "node manual_tests/capture-live-run.mjs --scenario subagents --harness codex --runner raw",
    "manual:subagents:codex:shared": "node manual_tests/capture-live-run.mjs --scenario subagents --harness codex --runner shared",
    "manual:subagents:claude:raw": "node manual_tests/capture-live-run.mjs --scenario subagents --harness claude --runner raw",
    "manual:subagents:claude:shared": "node manual_tests/capture-live-run.mjs --scenario subagents --harness claude --runner shared"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
