// Provider/model registry: the one data file. unleashd generates its typed
// catalog from this (shared/scripts/gen-catalog.ts); nothing reads it at runtime.
//
// To add a model: add an entry to the provider's `models` array, then run
// `pnpm --filter @unleashd/shared gen:catalog` in unleashd.
// `defaultModelId` must match one `id` in `models`; `reasoning.defaultEffort` one of its levels.
// `supportsDynamicModels` allows ad-hoc `provider/model` IDs (opencode).
// `aliases` map retired/shorthand ids onto a current `id` (historical session labels).
{
  "revision": "2026-09-30.latest-sol-default",
  "providers": [
    {
      "id": "claude",
      "displayName": "Claude",
      "shortName": "C",
      "defaultModelId": "claude-opus-5-5",
      "supportsDynamicModels": false,
      // CLI shorthands stored by older conversations and reported by imported sessions.
      "aliases": {
        "sonnet": "claude-sonnet-5-5"
      },
